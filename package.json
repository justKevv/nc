{
  "name": "nbcollab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Collaborative Jupyter-style notebooks in the browser. Pyodide kernels, Yjs CRDT sync, live cursors and a shared pen.",
  "scripts": {
    "dev": "concurrently -n server,web -c cyan,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "node --watch server/index.js",
    "dev:web": "vite",
    "build": "vite build",
    "start": "npm run build && node server/index.js",
    "share": "npm run build && node server/index.js --tunnel",
    "test": "node test/kernel.test.js && node test/notebook.test.js && node test/ink.test.js && node test/completions.test.js && node test/output-feed.test.js && node test/lobby.test.js && node test/protocol.test.js && node test/rooms-api.test.js",
    "fetch:pyodide": "node scripts/fetch-pyodide.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.18.4",
    "@codemirror/commands": "^6.7.1",
    "@codemirror/lang-python": "^6.1.7",
    "@codemirror/language": "^6.10.8",
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.36.1",
    "@lezer/highlight": "^1.2.1",
    "codemirror": "^6.0.1",
    "marked": "^15.0.4",
    "ws": "^8.18.0",
    "y-codemirror.next": "^0.3.5",
    "y-protocols": "^1.0.6",
    "yjs": "^13.6.21"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^6.0.7"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
